# Ministry Platform — Environment Variables
# Copy to .env.local and fill in values before deployment

# Database (required)
DATABASE_URL=mysql://user:password@host:3306/database_name
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ministry_platform
DB_PORT=3306
DB_SSL=false
DB_SSL_VERIFY=true

# Auth (required in production)
JWT_SECRET=change-this-to-a-long-random-string

# Optional: one-time admin setup endpoint protection
SETUP_ADMIN_SECRET=

# Public API base URL (default /api)
NEXT_PUBLIC_API_URL=/api

# Jitsi audio conferences (optional — defaults to meet.jit.si)
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
NEXT_PUBLIC_JITSI_ROOM_PREFIX=Ministry

# Build timestamp shown in footer (optional)
NEXT_PUBLIC_BUILD_TIME=

# Node environment
NODE_ENV=production
