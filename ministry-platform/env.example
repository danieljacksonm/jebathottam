# Ministry Platform — Environment Variables
# Copy to .env.local and fill in values before deployment

# Database (required)
DATABASE_URL=mysql://user:password@host:3306/database_name
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ministry_platform
DB_PORT=3306
DB_SSL=false
DB_SSL_VERIFY=true

# Auth (required in production)
JWT_SECRET=change-this-to-a-long-random-string
ATTENDANCE_IP_SALT=

# Prayer Collector Android API Bearer token (must match app config)
PRAYER_API_TOKEN=JebathottamPrayerCollector2026

# Contact form email (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=anselmajohn2020@gmail.com
CONTACT_FROM=noreply@jesusisthewayjebathottam.com

# Optional: one-time admin setup endpoint protection (unset after first use)
SETUP_ADMIN_SECRET=

# YouTube channel sync (POST /api/videos/sync — cron or super_admin)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCaRcFCKCmj1BgG1DTC3mlDw
CRON_SECRET=

# Public API base URL (default /api)
NEXT_PUBLIC_API_URL=/api

# Jitsi audio conferences (optional — defaults to meet.jit.si)
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
NEXT_PUBLIC_JITSI_ROOM_PREFIX=Ministry

# Build timestamp shown in footer (optional)
NEXT_PUBLIC_BUILD_TIME=

# Node environment
NODE_ENV=production
