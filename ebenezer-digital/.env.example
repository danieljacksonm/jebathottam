# Ebenezer Digital — Environment Variables
JWT_SECRET=change-this-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=https://ebenezerdigital.com
NEXT_PUBLIC_INFO_URL=https://ebenezerdigital.info
NEXT_PUBLIC_JOURNAL_URL=https://journal.ebenezerdigital.info
NEXT_PUBLIC_NEWS_URL=https://news.ebenezerdigital.info
NEXT_PUBLIC_STORE_URL=https://ebenezerdigital.store
NEXT_PUBLIC_PRODUCTS_URL=https://products.ebenezerdigital.com
NEXT_PUBLIC_TOOLS_URL=https://tools.ebenezerdigital.com
NEXT_PUBLIC_AI_URL=https://ai.ebenezerdigital.com
NEXT_PUBLIC_SAAS_URL=https://saas.ebenezerdigital.com
NEXT_PUBLIC_DISCOVER_URL=https://discover.ebenezerdigital.com
NEXT_PUBLIC_NETWORK_URL=https://ebenezerdigital.net
# Optional: Redis for API response caching (VPS)
REDIS_URL=redis://127.0.0.1:6379

# Optional: Groq API for fast AI hybrid replies (simple queries / fast mode)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# URL where the Yegova Billing app (yegova-saas) is running (legacy — SaaS CTAs now use /saas/login)
NEXT_PUBLIC_BILLING_URL=https://billing.ebenezerdigital.com

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML verification tokens (one per Search Console property)
# Fallback: NEXT_PUBLIC_GSC_VERIFICATION applies to studio (.com) and any host without its own token
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_GSC_VERIFICATION_INFO=
NEXT_PUBLIC_GSC_VERIFICATION_JOURNAL=
NEXT_PUBLIC_GSC_VERIFICATION_NEWS=
NEXT_PUBLIC_GSC_VERIFICATION_STORE=
NEXT_PUBLIC_GSC_VERIFICATION_PRODUCTS=
NEXT_PUBLIC_GSC_VERIFICATION_TOOLS=
NEXT_PUBLIC_GSC_VERIFICATION_AI=
NEXT_PUBLIC_GSC_VERIFICATION_SAAS=
NEXT_PUBLIC_GSC_VERIFICATION_DISCOVER=
NEXT_PUBLIC_GSC_VERIFICATION_NETWORK=

# Admin login password (default if unset: admin123)
ADMIN_DEFAULT_PASSWORD=admin123

# ---- Separate SaaS Login (independent from store/admin) ----
SAAS_LOGIN_EMAIL=saas@ebenezerdigital.com
SAAS_LOGIN_PASSWORD=change-this-saas-password
SAAS_JWT_SECRET=change-this-to-a-different-long-random-string

# Optional: The Guardian Open Platform key (free). Gives full article body.
# https://open-platform.theguardian.com/access/
# If unset, the site still loads Guardian/BBC/Hindu/Al Jazeera RSS (full text when the feed includes it).
GUARDIAN_API_KEY=

# ---- Ebenezer AI (Ollama on same VPS) ----
# Small model required: this VPS is ~8GB RAM + CPU only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Optional shared key for other products calling /api/ai/chat
AI_API_KEY=
# Optional: PayPal business email for paid invoices / future store charges
# Create a PayPal Business account, then put the same email here.
PAYPAL_BUSINESS_EMAIL=
