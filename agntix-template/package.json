{
  "name": "canaan-travel-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push && next build --webpack",
    "build:full": "prisma generate && prisma db push && node prisma/seed.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "images:catalog": "node prisma/build-image-catalog.mjs",
    "images:fill": "node prisma/fill-image-gaps.mjs",
    "images:apply": "node prisma/apply-place-images.mjs",
    "images:download": "node prisma/download-travel-images.mjs --backfill-blogs",
    "images:all": "npm run images:catalog && npm run images:fill && npm run images:apply && npm run images:download"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "nodemailer": "^9.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
