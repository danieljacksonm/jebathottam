generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Destination {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameTa    String
  nameHi    String
  country   String
  continent String
  region    String
  taglineEn String
  taglineTa String
  taglineHi String
  bodyEn    String
  bodyTa    String
  bodyHi    String
  image     String
  status    String   @default("enquiry")
  featured  Boolean  @default(false)
  priceFrom Int?
  sortOrder Int      @default(0)
  blogs     BlogPost[]
  places    TouristPlace[]
  packages  TravelPackage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TouristPlace {
  id            String      @id @default(cuid())
  slug          String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  nameEn        String
  nameTa        String
  nameHi        String
  summaryEn     String
  summaryTa     String
  summaryHi     String
  detailEn      String      @default("")
  detailTa      String      @default("")
  detailHi      String      @default("")
  bestTimeEn    String      @default("")
  bestTimeTa    String      @default("")
  bestTimeHi    String      @default("")
  image         String?
  sortOrder     Int         @default(0)
  blogs         BlogPost[]

  @@unique([destinationId, slug])
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  destinationId   String?
  destination     Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  placeId         String?
  place           TouristPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  status          String        @default("published") // draft | published | archived
  featured        Boolean       @default(false)
  publishedAt     DateTime?
  authorEn        String        @default("Canaan Travel Hub")
  authorTa        String        @default("கானான் டிராவல் ஹப்")
  authorHi        String        @default("कानान ट्रैवल हब")
  seoTitleEn      String        @default("")
  seoTitleTa      String        @default("")
  seoTitleHi      String        @default("")
  seoDescriptionEn String       @default("")
  seoDescriptionTa String       @default("")
  seoDescriptionHi String       @default("")
  ogImage         String?
  canonicalUrl    String?
  date            String
  readMinutes     Int
  image           String
  tagsEn          String
  tagsTa          String
  tagsHi          String
  titleEn         String
  titleTa         String
  titleHi         String
  excerptEn       String
  excerptTa       String
  excerptHi       String
  bodyEn          String
  bodyTa          String
  bodyHi          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([destinationId])
  @@index([placeId])
  @@index([date])
  @@index([status])
  @@index([featured])
}

model TravelPackage {
  id               String       @id @default(cuid())
  slug             String       @unique
  destinationSlug  String
  destinationId    String?
  destination      Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  nights           Int
  days             Int
  priceFrom        Int          @default(0)
  currency         String       @default("INR")
  image            String
  category         String       @default("escape")
  featured         Boolean      @default(false)
  published        Boolean      @default(true)
  pricingMode      String       @default("enquiry") // confirmed | enquiry
  sortOrder        Int          @default(0)
  titleJson        String
  blurbJson        String
  bodyJson         String
  taglineJson      String       @default("{}")
  highlightsJson   String
  sharedInclusionsJson String   @default("{}")
  tiersJson        String       @default("[]")
  groupNoteJson    String       @default("{}")
  detailsJson      String
  seoTitleEn       String       @default("")
  seoDescriptionEn String       @default("")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([destinationSlug])
  @@index([published])
  @@index([featured])
  @@index([sortOrder])
}

model DocumentSequence {
  id        String @id
  lastValue Int    @default(0)
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @default("")
  phone     String    @default("")
  whatsapp  String    @default("")
  country   String    @default("")
  notes     String    @default("")
  enquiries Enquiry[]
  quotes    Quote[]
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([phone])
}

model Enquiry {
  id                  String            @id @default(cuid())
  referenceNumber     String            @unique
  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String
  email               String
  phone               String
  whatsapp            String            @default("")
  country             String            @default("")
  destination         String            @default("")
  departureLocation   String            @default("")
  packageSlug         String            @default("")
  service             String            @default("")
  travelType          String            @default("")
  travelStartDate     String            @default("")
  travelEndDate       String            @default("")
  flexibleDates       Boolean           @default(false)
  adults              Int               @default(1)
  children            Int               @default(0)
  infants             Int               @default(0)
  budgetRange         String            @default("")
  currency            String            @default("INR")
  hotelPreference     String            @default("")
  transportPreference String            @default("")
  specialRequirements String            @default("")
  message             String            @default("")
  status              String            @default("NEW")
  priority            String            @default("NORMAL")
  source              String            @default("Website")
  sourcePage          String            @default("")
  locale              String            @default("en")
  utmSource           String            @default("")
  utmMedium           String            @default("")
  utmCampaign         String            @default("")
  utmContent          String            @default("")
  nextFollowUp        String            @default("")
  assignedAdmin       String            @default("")
  emailStatus         String            @default("not_sent")
  activities          EnquiryActivity[]
  quotes              Quote[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model EnquiryActivity {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  createdAt DateTime @default(now())

  @@index([enquiryId])
}

model Quote {
  id                String      @id @default(cuid())
  number            String      @unique
  enquiryId         String?
  enquiry           Enquiry?    @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status            String      @default("DRAFT")
  customerName      String
  email             String      @default("")
  phone             String      @default("")
  destination       String      @default("")
  packageSlug       String      @default("")
  travelStart       String      @default("")
  travelEnd         String      @default("")
  travellers        String      @default("")
  itinerary         String      @default("")
  currency          String      @default("INR")
  discountMinor     Int         @default(0)
  taxMinor          Int         @default(0)
  paymentTerms      String      @default("")
  cancellationNotes String      @default("")
  validityDate      String      @default("")
  notes             String      @default("")
  items             QuoteItem[]
  revisions         QuoteRevision[]
  invoice           Invoice?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
}

model QuoteRevision {
  id           String   @id @default(cuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revision     Int
  status       String
  snapshotJson String
  createdAt    DateTime @default(now())

  @@index([quoteId])
}

model StaffAccount {
  id           String   @id @default(cuid())
  name         String
  role         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([role])
}

model QuoteItem {
  id            String @id @default(cuid())
  quoteId       String
  quote         Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description   String
  quantity      Int    @default(1)
  unitMinor     Int    @default(0)
  discountMinor Int    @default(0)
  taxMinor      Int    @default(0)
  sortOrder     Int    @default(0)
}

model Invoice {
  id              String           @id @default(cuid())
  number          String           @unique
  quoteId         String?          @unique
  quote           Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          String           @default("DRAFT")
  customerName    String
  email           String           @default("")
  phone           String           @default("")
  customerAddress String           @default("")
  destination     String           @default("")
  reference       String           @default("")
  invoiceDate     String
  dueDate         String           @default("")
  travelStart     String           @default("")
  travelEnd       String           @default("")
  currency        String           @default("INR")
  discountMinor   Int              @default(0)
  companyGst      String           @default("")
  paymentTerms    String           @default("")
  cancellationNotes String         @default("")
  notes           String           @default("")
  items           InvoiceItem[]
  payments        InvoicePayment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([customerName])
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description   String
  quantity      Int     @default(1)
  unitMinor     Int     @default(0)
  discountMinor Int     @default(0)
  taxMinor      Int     @default(0)
  sortOrder     Int     @default(0)
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountMinor Int
  paidOn      String
  method      String   @default("")
  reference   String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model SocialAccount {
  id           String   @id @default(cuid())
  platform     String
  accountName  String
  externalId   String   @default("")
  status       String   @default("NOT_CONNECTED")
  tokenCipher  String   @default("")
  permissions  String   @default("")
  lastSync     String   @default("")
  lastError    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform])
}

model SocialCampaign {
  id        String       @id @default(cuid())
  name      String
  notes     String       @default("")
  posts     SocialPost[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SocialPost {
  id            String              @id @default(cuid())
  campaignId    String?
  campaign      SocialCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status        String              @default("DRAFT")
  title         String
  masterCaption String              @default("")
  language      String              @default("en")
  linkUrl       String              @default("")
  location      String              @default("")
  callToAction  String              @default("")
  mediaPath     String              @default("")
  relatedType   String              @default("")
  relatedSlug   String              @default("")
  scheduledFor  String              @default("")
  publishedAt   DateTime?
  lastError     String              @default("")
  variants      SocialPostVariant[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
  @@index([scheduledFor])
}

model SocialPostVariant {
  id        String     @id @default(cuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform  String
  caption   String     @default("")
  hashtags  String     @default("")
  status    String     @default("DRAFT")
  lastError String     @default("")

  @@unique([postId, platform])
}
