# Prisma resolves file:./data/content.db next to prisma/schema.prisma
# (that is prisma/data/content.db). On the VPS, scripts/vps-deploy.sh
# writes an absolute file: URL instead.
# Relative to prisma/schema.prisma → resolves to prisma/data/content.db
DATABASE_URL="file:./data/content.db"

NEXT_PUBLIC_SITE_URL=https://canaantravelhub.com

# Admin CMS (/admin) — REQUIRED for blog/destination/package management.
# Use a long random secret in production. Never commit the real value.
# On the VPS put this in .env or .env.production.local (not overwritten by deploy).
# ADMIN_PASSWORD=

# Optional enquiry email. Prefer .env.production.local on the VPS so
# these secrets stay out of git. The deploy script does not overwrite that file.
# ENQUIRY_NOTIFY_EMAIL=managingdirector@canaantravelhub.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Canaan Travel Hub <managingdirector@canaantravelhub.com>
