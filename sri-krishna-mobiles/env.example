# ============================================
# DATABASE (MongoDB - Required)
# ============================================
MONGODB_URI=mongodb://localhost:27017/sri-krishna-mobiles
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/sri-krishna-mobiles

# Legacy: Prisma/SQLite (kept for migration)
DATABASE_URL="file:./dev.db"

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-this-in-production

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin Master Password (for initial admin setup)
ADMIN_SECRET="your-secret-admin-key"

# ============================================
# PAYMENTS - Razorpay (Primary - India)
# ============================================
# Get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# PAYMENTS - PayPal (Optional - International)
# ============================================
# Get from https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ============================================
# NOTIFICATIONS - Email (Nodemailer)
# ============================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Sri Krishna Mobiles"
SMTP_FROM_EMAIL=noreply@srikrishnamobiles.com

# ============================================
# NOTIFICATIONS - SMS
# ============================================
# Twilio (https://www.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Fast2SMS (India alternative - https://www.fast2sms.com/)
FAST2SMS_API_KEY=

# ============================================
# FILE STORAGE - Cloudinary
# ============================================
# https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sri-krishna-mobiles

# ============================================
# SHOP / BUSINESS INFO
# ============================================
SHOP_NAME="Sri Krishna Mobiles"
SHOP_ADDRESS="Your Shop Address, City, State - PIN"
SHOP_PHONE=+91-XXXXXXXXXX
SHOP_EMAIL=contact@srikrishnamobiles.com
SHOP_GSTIN=XXXXXXXXXXXXXXX
SHOP_LOGO_URL=

# Thermal Printer Settings (ESC/POS)
PRINTER_VENDOR_ID=
PRINTER_PRODUCT_ID=

# ============================================
# SEO / ANALYTICS (Optional)
# ============================================
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
