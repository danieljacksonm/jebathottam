# Sri Krishna Mobiles — Environment Variables

# MongoDB (auth, orders, payments)
MONGODB_URI=mongodb://localhost:27017/sri-krishna-mobiles

# Prisma SQLite (product catalog — migrate to Postgres for production)
DATABASE_URL=file:./dev.db

# NextAuth (required)
NEXTAUTH_SECRET=change-this-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (required for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Email notifications
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Internal API key for server-side notification calls
INTERNAL_API_KEY=

# Admin legacy dashboard (replace with NextAuth roles in production)
ADMIN_SECRET=

# Shop info
SHOP_NAME=Sri Krishna Mobiles
SHOP_PHONE=+91-XXXXXXXXXX
