# Database (Prisma)
DATABASE_URL="file:./dev.db"

# Admin: use this value in the admin login form
ADMIN_SECRET="your-secret-key"

# PayPal (get from https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to "live" for production
PAYPAL_MODE=sandbox

# Razorpay (India: UPI, Cards, Netbanking) - https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: for server-side fetch in SSR (e.g. shop page)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
